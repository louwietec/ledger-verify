{
  "$id": "tsa_qualifiziert.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "ledger-tsa-qualifiziert/1"
    },
    "quelle": {
      "description": "where the auditor took it from",
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
      "type": "string"
    },
    "stand": {
      "description": "when the auditor compiled the file, grammar of format spec 10.7",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
      "type": "string"
    },
    "wurzeln": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "qualifiziert_ab": {
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
            "type": "string"
          },
          "qualifiziert_bis": {
            "description": "after qualifiziert_ab",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
            "type": "string"
          },
          "zertifikat": {
            "description": "base64 after B64 of a DER certificate after Z.1 with at most 16384 bytes",
            "maxLength": 21848,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
            "type": "string"
          }
        },
        "required": [
          "qualifiziert_ab",
          "zertifikat"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "format",
    "quelle",
    "stand",
    "wurzeln"
  ],
  "title": "ledger-tsa-qualifiziert/1 (registry auditor_inputs.tsa_qualified_roots_file)",
  "type": "object"
}
