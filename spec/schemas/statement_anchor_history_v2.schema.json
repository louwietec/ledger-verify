{
  "$id": "statement_anchor_history_v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "the signed anchor history of one chain, kind v2 (heartbeat spec 9.7, 9.10, from spec 1.10): GET /v1/anchors?chain_id=<uuid>&kind=ledger.anchor_history.v2[&since_tree_size=n]; the members of v1 plus owner_keys, forks_omitted, next_since_tree_size and affiliation; statement_jcs is printable ASCII (0x20 to 0x7E) of at most 131072 characters, every instant exactly YYYY-MM-DDThh:mm:ss.sssZ except server_ts in roots, which is the stored character string (from 1.10 in the same form, for a root recorded earlier as the server wrote it then); read by verifiers from 1.10 as an auditor input (format spec 8.8, 10.8)",
  "properties": {
    "server_key_id": {
      "description": "a key of role statements (format spec 10.7.3); until ende_doppelbetrieb the wrapper of licence statement, refusal and activation receipt and pages of kind v1 carry a countersigning key (format spec 10.7.5); key_id grammar of format spec 10.7.1",
      "pattern": "^[A-Za-z0-9._-]{1,64}$",
      "type": "string"
    },
    "server_signature": {
      "description": "Ed25519 over the UTF-8 bytes of statement_jcs",
      "pattern": "^[0-9a-f]{128}$",
      "type": "string"
    },
    "statement": {
      "additionalProperties": false,
      "properties": {
        "affiliation": {
          "additionalProperties": false,
          "description": "affiliation of the customer with the vendor after heartbeat spec 9.10, as of server_ts; JCS order known_since, periods; in a period bases, from, merged, recorded_ts, until",
          "properties": {
            "known_since": {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
              "type": [
                "string",
                "null"
              ]
            },
            "periods": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "bases": {
                    "description": "strictly ascending codes of heartbeat spec 9.10",
                    "items": {
                      "enum": [
                        "common_control",
                        "controlled_by_vendor",
                        "controls_vendor",
                        "former_relation",
                        "key_management",
                        "participation",
                        "shared_management",
                        "vendor"
                      ]
                    },
                    "maxItems": 8,
                    "minItems": 1,
                    "type": "array"
                  },
                  "from": {
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
                    "type": "string"
                  },
                  "merged": {
                    "type": "boolean"
                  },
                  "recorded_ts": {
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
                    "type": "string"
                  },
                  "until": {
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "bases",
                  "from",
                  "merged",
                  "recorded_ts",
                  "until"
                ],
                "type": "object"
              },
              "maxItems": 16,
              "type": "array"
            }
          },
          "required": [
            "known_since",
            "periods"
          ],
          "type": "object"
        },
        "chain_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "forks": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "detected_ts": {
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
                "type": "string"
              },
              "merkle_root": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "tree_size": {
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "detected_ts",
              "merkle_root",
              "tree_size"
            ],
            "type": "object"
          },
          "maxItems": 500,
          "type": "array"
        },
        "forks_omitted": {
          "description": "number of fork findings in the range of the page it does not list (signed omission marker)",
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "const": "ledger.anchor_history.v2"
        },
        "next_since_tree_size": {
          "description": "since_tree_size of the next page and exclusive upper bound of this page's range; null if and only if truncated is false",
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "owner_keys": {
          "description": "owner commitments, one per device key of the appliance the chain belongs to; strictly ascending",
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        },
        "predecessor": {
          "additionalProperties": false,
          "description": "registered chain succession as in v1",
          "properties": {
            "chain_id": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            "tree_size": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "chain_id",
            "tree_size"
          ],
          "type": [
            "object",
            "null"
          ]
        },
        "reference_tree_size": {
          "minimum": 0,
          "type": "integer"
        },
        "roots": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "merkle_root": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "recorded_as": {
                "enum": [
                  "countersigned",
                  "gap_witness",
                  "reported"
                ]
              },
              "server_ts": {
                "description": "the stored character string of the countersignature or recording (heartbeat spec 9.7 duty 6); from 1.10 written as YYYY-MM-DDThh:mm:ss.sssZ, for a root recorded earlier as the server wrote it then; page rules compare instants in whole milliseconds",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
                "type": "string"
              },
              "tree_size": {
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "merkle_root",
              "recorded_as",
              "server_ts",
              "tree_size"
            ],
            "type": "object"
          },
          "maxItems": 500,
          "type": "array"
        },
        "server_ts": {
          "description": "issue time, taken after every read for the page",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "type": "string"
        },
        "since_tree_size": {
          "minimum": 0,
          "type": "integer"
        },
        "successor": {
          "additionalProperties": false,
          "description": "registered successor as in v1",
          "properties": {
            "chain_id": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            "tree_size": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "chain_id",
            "tree_size"
          ],
          "type": [
            "object",
            "null"
          ]
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "affiliation",
        "chain_id",
        "forks",
        "forks_omitted",
        "kind",
        "next_since_tree_size",
        "owner_keys",
        "predecessor",
        "reference_tree_size",
        "roots",
        "server_ts",
        "since_tree_size",
        "successor",
        "truncated"
      ],
      "type": "object"
    },
    "statement_jcs": {
      "description": "the statement in JCS form (RFC 8785); only these UTF-8 bytes are signed; at most 2048 characters unless the kind names its own statement_jcs_maxlen (anchor_history_v2: 131072)",
      "maxLength": 131072,
      "pattern": "^[ -~]*$",
      "type": "string"
    }
  },
  "required": [
    "server_key_id",
    "server_signature",
    "statement",
    "statement_jcs"
  ],
  "title": "Signed vendor statement: anchor_history_v2",
  "type": "object"
}
