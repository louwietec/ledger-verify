{
  "$id": "entry_MODE_CHANGE.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "chain_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "entry_hash": {
      "description": "SHA-256 over RFC 8785 JCS of the entry WITHOUT the entry_hash field",
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "event_type": {
      "const": "MODE_CHANGE"
    },
    "mono_delta_ms": {
      "description": "monotonic ms since previous entry; -1 = unknown (first entry after process start)",
      "minimum": -1,
      "type": "integer"
    },
    "origin": {
      "enum": [
        "proxy",
        "import",
        "portal",
        "system"
      ]
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "maxLength": 128,
          "type": [
            "string",
            "null"
          ]
        },
        "cause": {
          "enum": [
            "manual",
            "disk_pressure"
          ]
        },
        "from": {
          "enum": [
            "full",
            "hash_only"
          ]
        },
        "to": {
          "enum": [
            "full",
            "hash_only"
          ]
        }
      },
      "required": [
        "actor",
        "cause",
        "from",
        "to"
      ],
      "type": "object"
    },
    "prev_hash": {
      "description": "entry_hash of previous entry; seq=1: 64 zeros",
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "seq": {
      "description": "strictly monotonic, no gaps",
      "minimum": 1,
      "type": "integer"
    },
    "spec_version": {
      "pattern": "^1\\.(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "ts_captured": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "type": "string"
    },
    "ts_chained": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "type": "string"
    }
  },
  "required": [
    "chain_id",
    "entry_hash",
    "event_type",
    "mono_delta_ms",
    "origin",
    "payload",
    "prev_hash",
    "seq",
    "spec_version",
    "ts_captured",
    "ts_chained"
  ],
  "title": "Chain entry: MODE_CHANGE",
  "type": "object"
}
