{
  "$id": "report_evidence_level.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "affiliation": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "affiliated",
            "not_affiliated",
            "not_determined",
            "not_checked"
          ]
        },
        "vendor_itself": {
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "vendor_itself"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "anchors": {
      "additionalProperties": false,
      "properties": {
        "expected_root_sources": {
          "description": "in the order auditor, anchor_history, as completeness.sources",
          "items": {
            "enum": [
              "auditor",
              "anchor_history"
            ]
          },
          "maxItems": 2,
          "type": "array"
        },
        "qualified_roots_file": {
          "additionalProperties": false,
          "properties": {
            "quelle": {
              "description": "copied as written in the file ledger-tsa-qualifiziert/1",
              "maxLength": 256,
              "type": "string"
            },
            "stand": {
              "description": "written as YYYY-MM-DDThh:mm:ss.sssZ, truncated to whole milliseconds, like every instant from an auditor input (format spec 10.10.1, instants)",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
              "type": "string"
            }
          },
          "required": [
            "quelle",
            "stand"
          ],
          "type": [
            "object",
            "null"
          ]
        },
        "statement_keys": {
          "description": "without repetition, the pairs of statements key and origin (key_id, public key, origin) of the used pages of the package on which a condition that is met rests: for expected_root_found with the source anchor_history the used pages that carry a recording of a found expected root that is recorded (format spec 8.8.5: recorded_as countersigned or gap_witness); for completeness_from_history, when it is met, every used page that enters the completeness (format spec 8.8.4, step H11), that is the fresh used pages of the package (format spec 8.8.4, older pages); for a page the pair is the one the report names for that page in anchor_history (if it names several, each of them); in the order of anchor_history.keys, each with how it is established (pin, or role list with version, wurzel_id and origin of the root); empty without such a page",
          "items": {
            "additionalProperties": false,
            "properties": {
              "key_id": {
                "pattern": "^[A-Za-z0-9._-]{1,64}$",
                "type": "string"
              },
              "list_version": {
                "minimum": 1,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "root_from": {
                "enum": [
                  "auditor",
                  "builtin",
                  null
                ]
              },
              "root_id": {
                "pattern": "^[A-Za-z0-9._-]{1,64}$",
                "type": [
                  "string",
                  "null"
                ]
              },
              "via": {
                "enum": [
                  "pinned",
                  "role_list"
                ]
              }
            },
            "required": [
              "key_id",
              "list_version",
              "root_from",
              "root_id",
              "via"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "tsa_roots": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "cert_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "credited_for": {
                "items": {
                  "enum": [
                    "time_witness",
                    "time_witness_qualified",
                    "log_day_qualified"
                  ]
                },
                "maxItems": 3,
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "cert_sha256",
              "credited_for"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "vendor_keys": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "key_id": {
                "pattern": "^[A-Za-z0-9._-]{1,64}$",
                "type": "string"
              },
              "list_version": {
                "minimum": 1,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "root_from": {
                "enum": [
                  "auditor",
                  "builtin",
                  null
                ]
              },
              "root_id": {
                "pattern": "^[A-Za-z0-9._-]{1,64}$",
                "type": [
                  "string",
                  "null"
                ]
              },
              "via": {
                "enum": [
                  "pinned",
                  "list"
                ]
              }
            },
            "required": [
              "key_id",
              "list_version",
              "root_from",
              "root_id",
              "via"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "expected_root_sources",
        "qualified_roots_file",
        "statement_keys",
        "tsa_roots",
        "vendor_keys"
      ],
      "type": [
        "object",
        "null"
      ]
    },
