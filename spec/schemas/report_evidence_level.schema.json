    "qualified_time": {
      "additionalProperties": false,
      "description": "at level 3 at seq 1 the item that proves the qualified time for the state up to up_to_tree_size: candidates are the credited items of time_witness_qualified (TIME_ANCHOR per root) and of log_day_qualified (receipt per time stamp and root) with tree_size >= up_to_tree_size; chosen is the one with the earliest genTime, compared as an instant to the nanosecond like the periods of format spec 10.8, before any cut to whole milliseconds, on a tie time_witness_qualified before log_day_qualified, then the smaller tree_size, then for log_day_qualified the earlier server_ts of the receipt; null below level 3 at seq 1 and outside the state rated (format spec 10.10.2)",
      "properties": {
        "gap_ms": {
          "description": "for log_day_qualified latest minus server_ts of the receipt in whole milliseconds, at most G_q; null for time_witness_qualified",
          "maximum": 129600000,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "latest": {
          "description": "genTime of the item, truncated to whole milliseconds, written as YYYY-MM-DDThh:mm:ss.sssZ: the state existed at the latest at this time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "type": "string"
        },
        "tree_size": {
          "minimum": 1,
          "type": "integer"
        },
        "via": {
          "enum": [
            "time_witness_qualified",
            "log_day_qualified"
          ]
        }
      },
      "required": [
        "gap_ms",
        "latest",
        "tree_size",
        "via"
      ],
      "type": [
        "object",
        "null"
      ]
    },
