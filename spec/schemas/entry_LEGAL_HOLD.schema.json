{
  "$id": "entry_LEGAL_HOLD.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "chain_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "entry_hash": {
      "description": "SHA-256 over RFC 8785 JCS of the entry WITHOUT the entry_hash field",
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "event_type": {
      "const": "LEGAL_HOLD"
    },
    "mono_delta_ms": {
      "description": "monotonic ms since previous entry; -1 = unknown (first entry after process start)",
      "minimum": -1,
      "type": "integer"
    },
    "origin": {
      "enum": [
        "proxy",
        "import",
        "portal",
        "system"
      ]
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "set",
            "release"
          ]
        },
        "actor": {
          "maxLength": 128,
          "type": "string"
        },
        "hold_id": {
          "maxLength": 64,
          "type": "string"
        },
        "reference": {
          "maxLength": 200,
          "type": "string"
        },
        "scope_from": {
          "description": "earliest ts_captured covered; unbounded: 0001-01-01T00:00:00.000Z (compared as a point in time)",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "type": "string"
        },
        "scope_to": {
          "description": "latest ts_captured covered; unbounded: 9999-12-31T23:59:59.000Z (compared as a point in time)",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "type": "string"
        }
      },
      "required": [
        "action",
        "actor",
        "hold_id",
        "reference",
        "scope_from",
        "scope_to"
      ],
      "type": "object"
    },
    "prev_hash": {
      "description": "entry_hash of previous entry; seq=1: 64 zeros",
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "seq": {
      "description": "strictly monotonic, no gaps",
      "minimum": 1,
      "type": "integer"
    },
    "spec_version": {
      "pattern": "^1\\.(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "ts_captured": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "type": "string"
    },
    "ts_chained": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "type": "string"
    }
  },
  "required": [
    "chain_id",
    "entry_hash",
    "event_type",
    "mono_delta_ms",
    "origin",
    "payload",
    "prev_hash",
    "seq",
    "spec_version",
    "ts_captured",
    "ts_chained"
  ],
  "title": "Chain entry: LEGAL_HOLD",
  "type": "object"
}
