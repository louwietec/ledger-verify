{
  "$defs": {
    "page": {
      "additionalProperties": false,
      "properties": {
        "server_key_id": {
          "pattern": "^[A-Za-z0-9._-]{1,64}$",
          "type": "string"
        },
        "server_signature": {
          "pattern": "^[0-9a-f]{128}$",
          "type": "string"
        },
        "statement": {
          "description": "the unsigned reading copy; any JSON value, not evaluated"
        },
        "statement_jcs": {
          "maxLength": 131072,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "server_key_id",
        "server_signature",
        "statement",
        "statement_jcs"
      ],
      "type": "object"
    }
  },
  "$id": "ankerhistorie_container.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "one file is either one page ($defs/page, the body of the HTTP response unchanged) or this container (format spec 8.8.2)",
  "properties": {
    "format": {
      "const": "ledger-ankerhistorie/2"
    },
    "pages": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "server_key_id": {
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "type": "string"
          },
          "server_signature": {
            "pattern": "^[0-9a-f]{128}$",
            "type": "string"
          },
          "statement": {
            "description": "the unsigned reading copy; any JSON value, not evaluated"
          },
          "statement_jcs": {
            "maxLength": 131072,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "server_key_id",
          "server_signature",
          "statement",
          "statement_jcs"
        ],
        "type": "object"
      },
      "maxItems": 4096,
      "minItems": 1,
      "type": "array"
    },
    "vendor_log": {
      "description": "extracts of the vendor log carried unchanged; each counts as a --vendor-log file with the bytes UTF-8(JCS(element))",
      "items": {
        "additionalProperties": false,
        "properties": {
          "chain_days": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "absent": {
                  "additionalProperties": false,
                  "properties": {
                    "neighbours": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "chain_root": {
                            "pattern": "^[0-9a-f]{64}$",
                            "type": "string"
                          },
                          "leaf_index": {
                            "maximum": 9007199254740991,
                            "minimum": 0,
                            "type": "integer"
                          },
                          "path": {
                            "items": {
                              "pattern": "^[0-9a-f]{64}$",
                              "type": "string"
                            },
                            "maxItems": 64,
                            "type": "array"
                          },
                          "position": {
                            "pattern": "^[0-9a-f]{64}$",
                            "type": "string"
                          }
                        },
                        "required": [
                          "chain_root",
                          "leaf_index",
                          "path",
                          "position"
                        ],
                        "type": "object"
                      },
                      "maxItems": 2,
                      "type": "array"
                    }
                  },
                  "required": [
                    "neighbours"
                  ],
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "day": {
                  "pattern": "^(?:[2-8][0-9]{3}|9[0-8][0-9]{2}|99[0-8][0-9]|999[0-8])-[0-9]{2}-[0-9]{2}$",
                  "type": "string"
                },
                "present": {
                  "additionalProperties": false,
                  "properties": {
                    "leaf_index": {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "path": {
                      "items": {
                        "pattern": "^[0-9a-f]{64}$",
                        "type": "string"
                      },
                      "maxItems": 64,
                      "type": "array"
                    },
                    "roots": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "merkle_root": {
                            "pattern": "^[0-9a-f]{64}$",
                            "type": "string"
                          },
                          "recorded_as": {
                            "enum": [
                              "countersigned",
                              "gap_witness"
                            ]
                          },
                          "server_ts": {
                            "description": "a value of type rfc3339, copied byte for byte from the receipt or the recording; from edition 1.10 the server writes it as YYYY-MM-DDThh:mm:ss.sssZ (heartbeat spec 9.1, 9.2), another form does not violate this grammar",
                            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
                            "type": "string"
                          },
                          "tree_size": {
                            "maximum": 9007199254740991,
                            "minimum": 1,
                            "type": "integer"
                          }
                        },
                        "required": [
                          "merkle_root",
                          "recorded_as",
                          "server_ts",
                          "tree_size"
                        ],
                        "type": "object"
                      },
                      "maxItems": 4096,
                      "minItems": 1,
                      "type": "array"
                    }
                  },
                  "required": [
                    "leaf_index",
                    "path",
                    "roots"
                  ],
                  "type": [
                    "object",
                    "null"
                  ]
                }
              },
              "required": [
                "absent",
                "day",
                "present"
              ],
              "type": "object"
            },
            "maxItems": 4000,
            "type": "array"
          },
          "chain_id": {
            "description": "null only with empty chain_days (the mirror extract <YYYY>.json at the places of publication)",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": [
              "string",
              "null"
            ]
          },
          "days": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "additional_signatures": {
                  "description": "format spec 7.4.8 (from edition 1.10): further signatures over UTF-8(statement_jcs); alg ed25519 carries a hex128 signature of a protocol key and is treated like the pair from entry (step L2 (a), (b)); any other alg is a seal this edition does not check, counted in vendor_log.days.signatures_not_checked; two equal elements violate the grammar; the generated schema does not express the two grammar rules (hex128 for ed25519, no equal elements), the verifier checks them at L0; a seal longer than 1024 characters needs a new format",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "alg": {
                        "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
                        "type": "string"
                      },
                      "key_id": {
                        "pattern": "^[A-Za-z0-9._-]{1,64}$",
                        "type": "string"
                      },
                      "signature": {
                        "maxLength": 1024,
                        "minLength": 1,
                        "pattern": "^[!-~]{1,1024}$",
                        "type": "string"
                      }
                    },
                    "required": [
                      "alg",
                      "key_id",
                      "signature"
                    ],
                    "type": "object"
                  },
                  "maxItems": 3,
                  "type": "array"
                },
                "entry": {
                  "additionalProperties": false,
                  "properties": {
                    "server_key_id": {
                      "pattern": "^[A-Za-z0-9._-]{1,64}$",
                      "type": "string"
                    },
                    "server_signature": {
                      "pattern": "^[0-9a-f]{128}$",
                      "type": "string"
                    },
                    "statement_jcs": {
                      "maxLength": 2048,
                      "type": "string"
                    }
                  },
                  "required": [
                    "server_key_id",
                    "server_signature",
                    "statement_jcs"
                  ],
                  "type": "object"
                },
                "timestamps": {
                  "items": {
                    "maxLength": 21848,
                    "type": "string"
                  },
                  "maxItems": 4,
                  "type": "array"
                }
              },
              "required": [
                "additional_signatures",
                "entry",
                "timestamps"
              ],
              "type": "object"
            },
            "maxItems": 4000,
            "type": "array"
          },
          "format": {
            "const": "ledger-protokollauszug/1"
          },
          "log_id": {
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "type": "string"
          },
          "protocol_keys": {
            "description": "a protocol key list (protocol_key_list), judged after format spec 7.4.7, not by this grammar",
            "type": [
              "object",
              "null"
            ]
          }
        },
        "required": [
          "chain_days",
          "chain_id",
          "days",
          "format",
          "log_id",
          "protocol_keys"
        ],
        "type": "object"
      },
      "maxItems": 128,
      "type": "array"
    }
  },
  "required": [
    "format",
    "pages",
    "vendor_log"
  ],
  "title": "Auditor file: anchor history (ledger-ankerhistorie/2 or one page)",
  "type": "object"
}
