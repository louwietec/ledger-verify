{
  "$id": "manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "chain_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "created_ts": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "type": "string"
    },
    "device_pubkeys": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "key_id": {
            "maxLength": 64,
            "type": "string"
          },
          "pubkey": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "key_id",
          "pubkey"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "segments": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "file": {
            "maxLength": 128,
            "type": "string"
          },
          "first_seq": {
            "minimum": 1,
            "type": "integer"
          },
          "last_seq": {
            "minimum": 1,
            "type": "integer"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "file",
          "first_seq",
          "last_seq",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "spec_version": {
      "pattern": "^1\\.(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "tree_size": {
      "minimum": 0,
      "type": "integer"
    },
    "vendor_pubkeys": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "key_id": {
            "maxLength": 64,
            "type": "string"
          },
          "pubkey": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "key_id",
          "pubkey"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "chain_id",
    "created_ts",
    "device_pubkeys",
    "segments",
    "spec_version",
    "tree_size",
    "vendor_pubkeys"
  ],
  "title": "Pruefpaket manifest",
  "type": "object"
}
