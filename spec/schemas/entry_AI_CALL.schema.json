{
  "$id": "entry_AI_CALL.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "chain_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "entry_hash": {
      "description": "SHA-256 over RFC 8785 JCS of the entry WITHOUT the entry_hash field",
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "event_type": {
      "const": "AI_CALL"
    },
    "mono_delta_ms": {
      "description": "monotonic ms since previous entry; -1 = unknown (first entry after process start)",
      "minimum": -1,
      "type": "integer"
    },
    "origin": {
      "enum": [
        "proxy",
        "import",
        "portal",
        "system"
      ]
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "description": "recorded = captured by proxy; claimed = asserted by provider/import source",
          "enum": [
            "recorded",
            "claimed"
          ]
        },
        "duration_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "endpoint": {
          "maxLength": 400,
          "type": "string"
        },
        "http_status": {
          "maximum": 599,
          "minimum": 0,
          "type": "integer"
        },
        "mode": {
          "enum": [
            "full",
            "hash_only"
          ]
        },
        "model": {
          "maxLength": 200,
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "enum": [
            "ok",
            "error",
            "upstream_error",
            "aborted"
          ]
        },
        "provider_class": {
          "enum": [
            "openai",
            "anthropic",
            "azure_openai",
            "google",
            "aws_bedrock",
            "mistral",
            "aleph_alpha",
            "ionos",
            "ollama",
            "vllm",
            "other_us",
            "other_eu",
            "other_local",
            "generic"
          ]
        },
        "request_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "request_commitment": {
          "description": "HMAC-SHA-256(salt, request plaintext); salt stored with vault object",
          "pattern": "^[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "response_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "response_commitment": {
          "pattern": "^[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "route": {
          "maxLength": 200,
          "type": "string"
        },
        "source_id": {
          "description": "import source identifier; null for proxy",
          "maxLength": 128,
          "type": [
            "string",
            "null"
          ]
        },
        "source_ref": {
          "description": "id inside the source for idempotency",
          "maxLength": 256,
          "type": [
            "string",
            "null"
          ]
        },
        "streamed": {
          "type": "boolean"
        },
        "tokens_in": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "tokens_out": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "vault_ref": {
          "maxLength": 128,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "confidence",
        "duration_ms",
        "endpoint",
        "http_status",
        "mode",
        "model",
        "outcome",
        "provider_class",
        "request_bytes",
        "request_commitment",
        "response_bytes",
        "response_commitment",
        "route",
        "source_id",
        "source_ref",
        "streamed",
        "tokens_in",
        "tokens_out",
        "vault_ref"
      ],
      "type": "object"
    },
    "prev_hash": {
      "description": "entry_hash of previous entry; seq=1: 64 zeros",
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "seq": {
      "description": "strictly monotonic, no gaps",
      "minimum": 1,
      "type": "integer"
    },
    "spec_version": {
      "pattern": "^1\\.(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "ts_captured": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "type": "string"
    },
    "ts_chained": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "type": "string"
    }
  },
  "required": [
    "chain_id",
    "entry_hash",
    "event_type",
    "mono_delta_ms",
    "origin",
    "payload",
    "prev_hash",
    "seq",
    "spec_version",
    "ts_captured",
    "ts_chained"
  ],
  "title": "Chain entry: AI_CALL",
  "type": "object"
}
