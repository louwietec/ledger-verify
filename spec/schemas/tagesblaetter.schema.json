{
  "$id": "tagesblaetter.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "day": {
      "pattern": "^(?:[2-8][0-9]{3}|9[0-8][0-9]{2}|99[0-8][0-9]|999[0-8])-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "format": {
      "const": "ledger-tagesblaetter/1"
    },
    "leaves": {
      "description": "one pair [position, chain_root] per leaf of the day tree, in tree order",
      "items": {
        "items": false,
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "description": "position",
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          {
            "description": "chain_root",
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        ],
        "type": "array"
      },
      "type": "array"
    },
    "log_id": {
      "pattern": "^[A-Za-z0-9._-]{1,64}$",
      "type": "string"
    }
  },
  "required": [
    "day",
    "format",
    "leaves",
    "log_id"
  ],
  "title": "ledger-tagesblaetter/1 (registry vendor_log.day_leaves)",
  "type": "object"
}
