{
  "$id": "vendor_log_extract_2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "chain_days": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "absent": {
            "additionalProperties": false,
            "properties": {
              "neighbours": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "chain_root": {
                      "pattern": "^[0-9a-f]{64}$",
                      "type": "string"
                    },
                    "leaf_index": {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "path": {
                      "items": {
                        "pattern": "^[0-9a-f]{64}$",
                        "type": "string"
                      },
                      "maxItems": 64,
                      "type": "array"
                    },
                    "position": {
                      "pattern": "^[0-9a-f]{64}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "chain_root",
                    "leaf_index",
                    "path",
                    "position"
                  ],
                  "type": "object"
                },
                "maxItems": 2,
                "type": "array"
              }
            },
            "required": [
              "neighbours"
            ],
            "type": [
              "object",
              "null"
            ]
          },
          "day": {
            "pattern": "^(?:[2-8][0-9]{3}|9[0-8][0-9]{2}|99[0-8][0-9]|999[0-8])-[0-9]{2}-[0-9]{2}$",
            "type": "string"
          },
          "present": {
            "additionalProperties": false,
            "properties": {
              "leaf_index": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "path": {
                "items": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                "maxItems": 64,
                "type": "array"
              },
              "roots": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "merkle_root": {
                      "pattern": "^[0-9a-f]{64}$",
                      "type": "string"
                    },
                    "recorded_as": {
                      "enum": [
                        "countersigned",
                        "gap_witness"
                      ]
                    },
                    "server_ts": {
                      "description": "a value of type rfc3339, copied byte for byte from the receipt or the recording; from edition 1.10 the server writes it as YYYY-MM-DDThh:mm:ss.sssZ (heartbeat spec 9.1, 9.2), another form does not violate this grammar",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
                      "type": "string"
                    },
                    "tree_size": {
                      "maximum": 9007199254740991,
                      "minimum": 1,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "merkle_root",
                    "recorded_as",
                    "server_ts",
                    "tree_size"
                  ],
                  "type": "object"
                },
                "maxItems": 4096,
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "leaf_index",
              "path",
              "roots"
            ],
            "type": [
              "object",
              "null"
            ]
          }
        },
        "required": [
          "absent",
          "day",
          "present"
        ],
        "type": "object"
      },
      "maxItems": 4000,
      "type": "array"
    },
    "chain_id": {
      "description": "null only with empty chain_days (the mirror extract <YYYY>.json at the places of publication)",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": [
        "string",
        "null"
      ]
    },
    "cose_receipts": {
      "description": "COSE objects in B64 on countersignatures of the chain chain_id; not empty only with chain_id not null; grammar and limits only, their check is format spec 7.7; two equal elements violate the grammar",
      "items": {
        "maxLength": 1368,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 131072,
      "type": "array"
    },
    "days": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "additional_signatures": {
            "description": "format spec 7.4.8 (from edition 1.10): further signatures over UTF-8(statement_jcs); alg ed25519 carries a hex128 signature of a protocol key and is treated like the pair from entry (step L2 (a), (b)); any other alg is a seal this edition does not check, counted in vendor_log.days.signatures_not_checked; two equal elements violate the grammar; the generated schema does not express the two grammar rules (hex128 for ed25519, no equal elements), the verifier checks them at L0; a seal longer than 1024 characters needs a new format",
            "items": {
              "additionalProperties": false,
              "properties": {
                "alg": {
                  "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
                  "type": "string"
                },
                "key_id": {
                  "pattern": "^[A-Za-z0-9._-]{1,64}$",
                  "type": "string"
                },
                "signature": {
                  "maxLength": 1024,
                  "minLength": 1,
                  "pattern": "^[!-~]{1,1024}$",
                  "type": "string"
                }
              },
              "required": [
                "alg",
                "key_id",
                "signature"
              ],
              "type": "object"
            },
            "maxItems": 3,
            "type": "array"
          },
          "day_receipts": {
            "description": "COSE objects in B64 on the day of the day object; grammar and limits only, their check is format spec 7.7; two equal elements violate the grammar",
            "items": {
              "maxLength": 1368,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 2,
            "type": "array"
          },
          "entry": {
            "additionalProperties": false,
            "properties": {
              "server_key_id": {
                "pattern": "^[A-Za-z0-9._-]{1,64}$",
                "type": "string"
              },
              "server_signature": {
                "pattern": "^[0-9a-f]{128}$",
                "type": "string"
              },
              "statement_jcs": {
                "maxLength": 2048,
                "type": "string"
              }
            },
            "required": [
              "server_key_id",
              "server_signature",
              "statement_jcs"
            ],
            "type": "object"
          },
          "seals": {
            "description": "format spec 7.4.8a: type ml-dsa-87 needs key_id not null and is checked at step L2 (b'), (e'), (g'); type cades-b-t needs key_id null and is not checked in this edition; any other type is not checked; not checked seals count in vendor_log.seals.not_checked and never yield a finding; two equal seals (type, key_id, value) in one day object violate the grammar (checked at L0, not expressed by the generated schema)",
            "items": {
              "additionalProperties": false,
              "properties": {
                "key_id": {
                  "pattern": "^[A-Za-z0-9._-]{1,64}$",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "type": {
                  "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
                  "type": "string"
                },
                "value": {
                  "maxLength": 87384,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "key_id",
                "type",
                "value"
              ],
              "type": "object"
            },
            "maxItems": 4,
            "type": "array"
          },
          "timestamps": {
            "items": {
              "maxLength": 21848,
              "type": "string"
            },
            "maxItems": 4,
            "type": "array"
          }
        },
        "required": [
          "additional_signatures",
          "day_receipts",
          "entry",
          "seals",
          "timestamps"
        ],
        "type": "object"
      },
      "maxItems": 4000,
      "type": "array"
    },
    "format": {
      "const": "ledger-protokollauszug/2"
    },
    "log_id": {
      "pattern": "^[A-Za-z0-9._-]{1,64}$",
      "type": "string"
    },
    "protocol_keys": {
      "description": "a protocol key list /1 or /2 (protocol_key_list, protocol_key_list_2), judged after format spec 7.4.7 or 7.4.7a, not by this grammar; a list /2 here is ineffective above 1 048 576 bytes of UTF-8(JCS(list)); before the first list /2 the vendor puts the list /1 here",
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "chain_days",
    "chain_id",
    "cose_receipts",
    "days",
    "format",
    "log_id",
    "protocol_keys"
  ],
  "title": "ledger-protokollauszug/2 (registry vendor_log.extract_2)",
  "type": "object"
}
