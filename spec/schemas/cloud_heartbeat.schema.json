{
  "$id": "cloud_heartbeat.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "alarms_24h_by_rule": {
      "additionalProperties": {
        "minimum": 0,
        "type": "integer"
      },
      "propertyNames": {
        "enum": [
          "source_silence",
          "volume_spike",
          "error_rate_spike",
          "new_provider_class",
          "spool_backlog",
          "disk_85",
          "disk_92",
          "disk_97",
          "cert_expiry",
          "anchor_overdue",
          "report_missing",
          "report_delivery_failed",
          "component_silence",
          "test_alarm"
        ]
      },
      "type": "object"
    },
    "appliance_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "calls_24h_by_provider_class": {
      "additionalProperties": {
        "minimum": 0,
        "type": "integer"
      },
      "propertyNames": {
        "enum": [
          "openai",
          "anthropic",
          "azure_openai",
          "google",
          "aws_bedrock",
          "mistral",
          "aleph_alpha",
          "ionos",
          "ollama",
          "vllm",
          "other_us",
          "other_eu",
          "other_local",
          "generic"
        ]
      },
      "type": "object"
    },
    "disk_pct": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
    },
    "events_24h": {
      "minimum": 0,
      "type": "integer"
    },
    "events_24h_by_type": {
      "additionalProperties": {
        "minimum": 0,
        "type": "integer"
      },
      "propertyNames": {
        "enum": [
          "GENESIS",
          "AI_CALL",
          "TICK",
          "GAP",
          "SOURCE_GAP",
          "RECONCILIATION",
          "CLOCK_JUMP",
          "MODE_CHANGE",
          "RESTART",
          "SEAL",
          "RESUME",
          "OVERSIGHT",
          "ALARM",
          "CONFIG_CHANGE",
          "KEY_ROTATION",
          "REPORT_ISSUED",
          "CONTENT_DELETED",
          "CONTENT_DISCLOSED",
          "ADMIN",
          "CHECKPOINT",
          "CHECKPOINT_RECEIPT",
          "TIME_ANCHOR",
          "CAPTURE_TRUNCATED",
          "LEGAL_HOLD",
          "DATA_ACCESS"
        ]
      },
      "type": "object"
    },
    "events_total": {
      "minimum": 0,
      "type": "integer"
    },
    "gap_count_24h": {
      "minimum": 0,
      "type": "integer"
    },
    "gap_seconds_24h": {
      "minimum": 0,
      "type": "integer"
    },
    "health": {
      "additionalProperties": {
        "enum": [
          "green",
          "yellow",
          "red"
        ]
      },
      "propertyNames": {
        "enum": [
          "schleuse",
          "kern",
          "portal",
          "telemetrie"
        ]
      },
      "type": "object"
    },
    "last_checkpoint": {
      "additionalProperties": false,
      "properties": {
        "chain_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "merkle_root": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "tree_size": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "chain_id",
        "merkle_root",
        "tree_size"
      ],
      "type": "object"
    },
    "loss_counter": {
      "minimum": 0,
      "type": "integer"
    },
    "mode": {
      "enum": [
        "full",
        "hash_only"
      ]
    },
    "oversight_count_24h": {
      "minimum": 0,
      "type": "integer"
    },
    "sig": {
      "pattern": "^[0-9a-f]{128}$",
      "type": "string"
    },
    "spec_version": {
      "description": "MAJOR.MINOR of the specification the appliance implements (format spec 10.6); the server accepts every MINOR of its own MAJOR and steers the anchor contract by it (heartbeat spec section 6/9)",
      "pattern": "^1\\.(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "spool_backlog": {
      "minimum": 0,
      "type": "integer"
    },
    "ts": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "type": "string"
    },
    "uptime_s": {
      "minimum": 0,
      "type": "integer"
    },
    "version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$",
      "type": "string"
    }
  },
  "required": [
    "alarms_24h_by_rule",
    "appliance_id",
    "calls_24h_by_provider_class",
    "disk_pct",
    "events_24h",
    "events_24h_by_type",
    "events_total",
    "gap_count_24h",
    "gap_seconds_24h",
    "health",
    "last_checkpoint",
    "loss_counter",
    "mode",
    "oversight_count_24h",
    "sig",
    "spec_version",
    "spool_backlog",
    "ts",
    "uptime_s",
    "version"
  ],
  "title": "Cloud message: heartbeat",
  "type": "object"
}
